# === LLM API Keys ===
# Multiple keys can be comma-separated for round-robin rotation
# across different quotas (e.g. free-tier keys from separate projects).
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEY=key-from-project-1, key-from-project-2, key-from-project-3
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
# DeepSeek uses OpenAI-compatible API:
# openai.OpenAI(api_key=DEEPSEEK_API_KEY, base_url="https://api.deepseek.com")
MISTRAL_API_KEY=your-mistral-api-key
# Mistral uses OpenAI-compatible API via openai SDK with base_url=https://api.mistral.ai/v1
ALIBABA_API_KEY=your-alibaba-api-key
# Alibaba DashScope (Qwen3-VL family). The env var keeps the Alibaba
# brand name; the internal provider key is "dashscope".
# For MaaS workspace endpoints (eu-central-1, etc.), override the
# default Singapore endpoint via DASHSCOPE_BASE_URL:
# DASHSCOPE_BASE_URL=https://{workspaceId}.eu-central-1.maas.aliyuncs.com/api/v1

# === STT API Keys ===
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# OpenAI STT (gpt-4o-mini-transcribe) uses the same OPENAI_API_KEY

# === PostgreSQL (docker image: pgvector/pgvector:pg17) ===
POSTGRES_USER=course_supporter
POSTGRES_PASSWORD=secret
POSTGRES_DB=course_supporter
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Composed URL for SQLAlchemy (assembled in config.py from individual vars)
# DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# === Storage (S3-compatible; dev: SeaweedFS from docker-compose) ===
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=course-materials

# === Redis (task queue backend) ===
REDIS_URL=redis://localhost:6379/0

# === Worker (ARQ task queue) ===
# Max concurrent jobs. Default 1 to avoid OOM on VPS (Whisper uses ~5 GB RAM).
# Increase only if the host has enough memory for parallel heavy tasks.
WORKER_MAX_JOBS=1
# Max seconds per job. Default 21600 (6h) — enough for Whisper transcription
# of 4-hour videos on CPU (~2-4h processing time). Increase for longer media.
WORKER_JOB_TIMEOUT=21600
WORKER_MAX_TRIES=3
WORKER_HEAVY_WINDOW_START=02:00
WORKER_HEAVY_WINDOW_END=06:30
WORKER_HEAVY_WINDOW_ENABLED=false
WORKER_HEAVY_WINDOW_TZ=UTC
WORKER_IMMEDIATE_OVERRIDE=true

# Call register: write the full rendered input of every LLM attempt.
# Development only — it carries student submissions; production refuses to boot
# with it raised.
CALL_REGISTER_FULL_INPUT=false

# === Visual Description (VD) Pipeline ===
# Primary Vision LLM model for per-frame analysis (Eyes step in VisualAnalyzer)
VD_MODEL=gemini-2.5-flash
# Fallback model used on 429 rate-limit retry (VisualAnalyzer + MemoryPipeline)
VD_FALLBACK_MODEL=gemini-3.1-flash-lite-preview
# Max requests per minute per Gemini API key (rate limiter in VisualAnalyzer)
VD_RPM_PER_KEY=5
# Enable/disable VD pipeline in VideoProcessor (false = STT-only processing)
VD_ENABLED=true

# === Billing (BIL-A) ===
# Revision of the billing terms in force (YYYY-MM-DD, the date it took effect;
# чинна редакція умов сайту 1.1 від 13.11). A portal student without consent to
# this revision is asked to agree.
BILLING_TERMS_VERSION=2026-11-13

# === Payments (BIL-PAY) ===
# Payment providers switched on, by adapter name, as a JSON list; the first is
# the default. Empty = payment unavailable (a checkout answers 503). "fake" is
# the test provider: development and testing only.
# BILLING_PROVIDERS=["fake"]
# Base URL of the author SPA: an author's checkout returns to {it}/billing.
# AUTHOR_APP_BASE_URL=http://localhost:5173
# Creem (BILLING_PROVIDERS=["creem"]): the test mode's API key and webhook
# secret, from the Creem dashboard in Test Mode (Developers). Without both,
# "creem" in BILLING_PROVIDERS stops the startup. Never commit real values.
# CREEM_API_BASE is the test host by default; the live one is
# https://api.creem.io/v1 and takes the live mode's key (they do not mix).
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_API_BASE=https://test-api.creem.io/v1

# === Periodic tasks (BIL-B part 2) ===
# ARQ cron jobs of the default worker. Defaults shown; uncomment to change.
# Each task: PERIODIC_<TASK>_ENABLED and PERIODIC_<TASK>_CRON (five fields, UTC).
# PERIODIC_BILLING_EXPIRE_CRON=5 * * * *
# PERIODIC_BILLING_ANNUL_CRON=10 * * * *
# PERIODIC_BILLING_STALE_RESERVES_CRON=*/15 * * * *
# PERIODIC_BILLING_PURGE_CRON=30 3 * * *
# PERIODIC_BILLING_PURGE_ENABLED=true
# BILLING_STALE_RESERVE_HOURS=24
# BILLING_RETENTION_YEARS=5
# BILLING_PURGE_BATCH_SIZE=50

# === App ===
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# === CORS ===
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_METHODS=["GET","POST","PUT","DELETE","PATCH"]
CORS_ALLOWED_HEADERS=["Content-Type","X-API-Key","Authorization"]
