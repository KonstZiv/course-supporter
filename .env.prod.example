# Production environment template. Copy to .env.prod and fill in.
# Values below are PLACEHOLDERS — never commit real secrets.
# The app + worker containers load this via `env_file: .env.prod`.

# === App ===
ENVIRONMENT=production
LOG_LEVEL=INFO

# === CORS ===
# Add the portal SPA origin here too if it is deployed cross-origin.
CORS_ALLOWED_ORIGINS=["https://pythoncourse.me"]
CORS_ALLOW_CREDENTIALS=true
# DELETE is required for delete-document + portal unbind.
CORS_ALLOWED_METHODS=["GET","POST","DELETE"]
# Authorization is required for the portal bearer token (Phase 6 T1).
CORS_ALLOWED_HEADERS=["Content-Type","X-API-Key","Authorization"]

# === Student portal session (Phase 6 T1, KD17) ===
# MANDATORY in prod: startup HARDFAILS without it (config.py:193). The dev
# default would let anyone forge a student's session token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
PORTAL_SESSION_SECRET=<generate-with-secrets.token_urlsafe(64)>
# Portal bearer token lifetime in hours (optional; default 12).
# PORTAL_SESSION_TTL_HOURS=12

# === PostgreSQL ===
POSTGRES_USER=course_supporter
POSTGRES_PASSWORD=<generate-strong-password>
POSTGRES_DB=course_supporter
POSTGRES_HOST=postgres-cs
POSTGRES_PORT=5432

# === Redis (task queue backend) ===
# Default is localhost; in the compose stack the service is named `redis`.
REDIS_URL=redis://redis:6379/0

# === Backblaze B2 (S3-compatible) ===
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_ACCESS_KEY=<backblaze-app-key-id>
S3_SECRET_KEY=<backblaze-app-key>
S3_BUCKET=course-supporter-materials

# === LLM API Keys ===
# Multiple keys may be comma-separated for round-robin rotation.
GEMINI_API_KEY=<key>
ANTHROPIC_API_KEY=<key>
OPENAI_API_KEY=<key>
# DEEPSEEK_API_KEY powers both the deepseek and deepseek_thinking providers.
DEEPSEEK_API_KEY=<key>
# Mistral (presentation Pass 2a).
MISTRAL_API_KEY=<key>
# Alibaba DashScope (qwen3-vl video / presentation). The env var keeps the
# Alibaba brand name; the internal provider key is "dashscope".
ALIBABA_API_KEY=<key>
# For MaaS workspace endpoints (eu-central-1, etc.), override the default
# Singapore endpoint:
# DASHSCOPE_BASE_URL=https://{workspaceId}.eu-central-1.maas.aliyuncs.com/api/v1

# === STT API Keys ===
ELEVENLABS_API_KEY=<key>
DEEPGRAM_API_KEY=<key>
# OpenAI STT (gpt-4o-mini-transcribe) reuses OPENAI_API_KEY above.

# === Worker (ARQ) — tuning knobs; prod defaults shown (calibrated for the
#     2-vCPU profile, DD-3.3c). Uncomment to override. ===
# WORKER_MAX_JOBS=1
# WORKER_JOB_TIMEOUT=21600
# WORKER_MAX_TRIES=3
# WORKER_HEAVY_WINDOW_START=02:00
# WORKER_HEAVY_WINDOW_END=06:30
# WORKER_HEAVY_WINDOW_ENABLED=false
# WORKER_HEAVY_WINDOW_TZ=UTC
# WORKER_IMMEDIATE_OVERRIDE=true

# === Intake admission / queue lifetime (DD-3.3c-I) — tuning knobs; prod
#     defaults shown. Uncomment to override. ===
# WARNING: cross-validated at boot (config.py:161) — INTAKE_JOB_EXPIRES_HOURS
# must be >= INTAKE_ADMISSION_MAX_PENDING_VIDEO_HOURS * INTAKE_DRAIN_COEFFICIENT
# or startup HARDFAILS. Change one, re-check the other.
# INTAKE_ADMISSION_MAX_PENDING_VIDEO_HOURS=60.0
# INTAKE_DRAIN_COEFFICIENT=1.4
# INTAKE_JOB_EXPIRES_HOURS=96.0
# INTAKE_HINT_MAX_HOURS=84.0
# INTAKE_HINT_CHECK_AFTER_HOURS=12.0
