# Worker image (Phase 2.3 sub-area #7, KD-2.3-I FLAG D).
#
# Identical to ``Dockerfile`` (the API image) plus headless LibreOffice for
# PPTX/PPT -> PDF normalization in the ingestion worker. Kept as a SEPARATE
# Dockerfile (deliberate duplication, NOT a shared base) so the API image
# stays lightweight -- the sealed KD-2.3-I operational note (~250 MB savings).
# A base-extraction refactor is deferred to DD-2.3-AI (trigger: a third
# consumer of the shared build structure). The worker command, ``expose: []``
# and ``healthcheck: disable`` are set in docker-compose.prod.yaml.

# ── Build stage ──
FROM python:3.13-slim AS builder

WORKDIR /build

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Install dependencies (cached layer)
COPY pyproject.toml uv.lock .python-version ./
ENV UV_LINK_MODE=copy
RUN uv sync --no-dev --frozen --no-install-project

# Copy application code
COPY src/ src/
COPY config/ config/
COPY prompts/ prompts/
COPY migrations/ migrations/
COPY alembic.ini .
COPY scripts/ scripts/

# ── Runtime stage ──
FROM python:3.13-slim

# System dependencies: libpq for psycopg, ffmpeg for ingestion, libmagic for
# security file-type detection (KD14), libreoffice-impress for the worker-side
# PPTX/PPT -> PDF normalize (KD-2.3-I; pulls libreoffice-core -> soffice). The
# trailing ``libreoffice --version`` is a build-time gate: a broken install
# fails the image build instead of surfacing at deploy/runtime.
#
# libmagic is PINNED to 1:5.47-4 from sid, identically to ``Dockerfile`` -- see
# the full rationale there (Debian #1102577: 5.46's ``magic_buffer`` misses a
# plain zip). This image matters most for it: ``homework-worker`` and ``worker``
# both build from here, and ``run_stage1`` for homework executes in this image,
# so the production rejection of every student archive happened HERE.
RUN printf 'Types: deb\nURIs: http://deb.debian.org/debian\nSuites: sid\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n' \
        > /etc/apt/sources.list.d/sid.sources \
    && printf 'Package: *\nPin: release a=unstable\nPin-Priority: 100\n\nPackage: libmagic1t64 libmagic-mgc\nPin: release a=unstable\nPin-Priority: 990\n' \
        > /etc/apt/preferences.d/libmagic-sid \
    && apt-get update && apt-get install -y --no-install-recommends \
        libpq5 curl ffmpeg libreoffice-impress \
        libmagic1t64=1:5.47-4 libmagic-mgc=1:5.47-4 \
    && rm -f /etc/apt/sources.list.d/sid.sources /etc/apt/preferences.d/libmagic-sid \
    && rm -rf /var/lib/apt/lists/* \
    && libreoffice --version

RUN groupadd -r app && useradd -r -g app -d /app app
WORKDIR /app
RUN mkdir -p /app/.cache && chown app:app /app/.cache

# Copy virtual environment and application
COPY --from=builder /build/.venv .venv/
COPY --from=builder /build/src src/
COPY --from=builder /build/config config/
COPY --from=builder /build/prompts prompts/
COPY --from=builder /build/migrations migrations/
COPY --from=builder /build/alembic.ini .
COPY --from=builder /build/scripts scripts/

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV XDG_CACHE_HOME="/app/.cache"

# Build-time format gate — see the twin block in ``Dockerfile`` for why it runs
# in the runtime stage. ``--image worker`` selects this image's exception list:
# libreoffice-impress converts pptx -> ppt, so ppt IS proven here (and only
# here); doc and xls need Writer and Calc, which neither image installs.
RUN python scripts/magic_format_gate.py --image worker

USER app

# Identity carrier for the deploy gate. The workflow passes the commit it is
# deploying; the gate then reads this label off every running container and
# compares it with that commit, so a container silently left on an older image
# turns the run red instead of passing unnoticed. The ``unknown`` default is
# deliberate: a build without the arg must fail that comparison rather than
# pass itself off as the target commit.
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$GIT_SHA

# Default command (overridden by docker-compose.prod.yaml worker service to
# ``arq course_supporter.worker.WorkerSettings``).
CMD ["python", "-m", "arq", "course_supporter.worker.WorkerSettings"]
